# Скопируйте в .env.capacitor перед npm run cap:sync / npm run android:apk

# Публичный сервер (проброс портов: 6080→80, 6443→443)
# HTTP — для теста без SSL:
VITE_API_BASE_URL=http://77.50.193.34:6080/api
CAPACITOR_SERVER_URL=http://77.50.193.34:6080

# HTTPS — после настройки SSL на сервере:
# VITE_API_BASE_URL=https://skorostivkus.ru:6443/api
# CAPACITOR_SERVER_URL=https://skorostivkus.ru:6443

# Локальная разработка (ПК + телефон в одном Wi‑Fi):
# VITE_API_BASE_URL=http://192.168.0.100:8080/api
# CAPACITOR_SERVER_URL=http://192.168.0.100:8080
