# Скопируйте в .env.capacitor перед сборкой APK

# API на сервере (самоподписанный сертификат вшит в APK)
VITE_API_BASE_URL=https://77.50.193.34:6443/api

# НЕ задавайте CAPACITOR_SERVER_URL — интерфейс должен быть вшит в APK (быстрый старт).
# Remote URL загружает весь сайт с сервера при каждом запуске — медленно и зависит от сети.

# Или по домену:
# VITE_API_BASE_URL=https://skorostivkus.ru:6443/api

# Локальная разработка:
# VITE_API_BASE_URL=http://192.168.0.100:8080/api

# Только для live-reload при разработке на устройстве (не для release APK):
# CAPACITOR_SERVER_URL=http://192.168.0.100:8080
